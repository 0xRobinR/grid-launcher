<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only. The window is transparent and shows the wallpaper; Compose paints the
         solid background on top unless "Show wallpaper" is turned on. -->
    <style name="Theme.GridLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#FF9DB8FF</item>
    </style>
</resources>
